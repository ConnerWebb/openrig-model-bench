[Unit]
Description=Read-only OpenRig performance dashboard (localhost only)

[Service]
Type=simple
WorkingDirectory=/home/cow/Documents/Codex/2026-11-05/referenced-chatgpt-conversation-this-is-an/outputs/openrig-programming-20261109-235342/progress/performance-visuals/live-v1
